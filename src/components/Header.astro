---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconX from "@/assets/icons/IconX.svg";
import { stripBase, stripLocale } from "@/utils/withBase";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const currentPath = stripLocale(
  stripBase(Astro.url.pathname).replace(/\/+$/, ""),
  locale
);

const navItems = [
  { label: "笔记", path: "notes" },
  { label: "作品", path: "projects" },
  { label: "碎碎念", path: "thoughts" },
  { label: "标签", path: "tags" },
  { label: "关于", path: "about" },
].map(item => ({
  ...item,
  href: getRelativeLocaleUrl(locale, item.path),
}));

const searchHref = getRelativeLocaleUrl(locale, "search");
const isActive = (path: string) =>
  currentPath === `/${path}` || currentPath.startsWith(`/${path}/`);
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-accent text-accent-foreground focus-outline absolute inset-s-4 -top-full z-50 px-4 py-2 font-mono text-sm font-semibold focus:top-3"
>
  跳到正文
</a>

<header
  class="border-border bg-background/85 sticky top-0 z-30 border-b backdrop-blur-xl"
>
  <div class="app-layout flex h-16 items-center justify-between gap-4">
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="group flex items-center gap-3 no-underline"
      aria-label="Grimmjow 首页"
    >
      <span
        class="border-accent/40 bg-accent/10 text-accent group-hover:border-accent group-hover:bg-accent group-hover:text-accent-foreground grid size-8 place-items-center rounded border font-mono text-xs font-bold transition-colors"
        aria-hidden="true">&gt;_</span
      >
      <span class="flex flex-col leading-none">
        <strong
          class="font-mono text-sm font-semibold tracking-[0.12em] uppercase"
        >
          {config.site.title}
        </strong>
        <span
          class="text-muted-foreground mt-1 font-mono text-[0.58rem] tracking-[0.18em]"
        >
          ~/personal.log
        </span>
      </span>
    </a>

    <button
      id="menu-btn"
      class="focus-outline border-border bg-panel grid size-9 place-items-center rounded border md:hidden"
      aria-label="打开菜单"
      aria-expanded="false"
      aria-controls="menu-items"
      data-open-label="打开菜单"
      data-close-label="关闭菜单"
    >
      <IconMenuDeep id="menu-icon" class="size-4" />
      <IconX id="close-icon" class="hidden size-4" />
    </button>

    <nav
      aria-label="主导航"
      class="max-md:border-border max-md:bg-background/95 max-md:absolute max-md:top-16 max-md:right-0 max-md:left-0 max-md:border-b max-md:backdrop-blur-xl"
    >
      <ul id="menu-items" class="hidden items-center gap-1 md:flex">
        {
          navItems.map(item => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.path) ? "page" : undefined}
                class:list={[
                  "text-muted-foreground hover:text-foreground block rounded px-2.5 py-1.5 font-mono text-[0.72rem] tracking-wider no-underline transition-colors",
                  {
                    "border-accent/25 bg-accent/10 text-accent border":
                      isActive(item.path),
                  },
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="border-border ms-1 border-s ps-1">
          <a
            id="header-search"
            href={searchHref}
            class="text-muted-foreground hover:text-accent grid size-9 place-items-center rounded no-underline transition-colors"
            aria-label="搜索内容（Ctrl+K）"
            title="搜索内容（Ctrl+K）"
          >
            <IconSearch class="size-4" />
          </a>
        </li>
        {
          config.features.lightAndDarkMode && (
            <li>
              <button
                id="theme-btn"
                type="button"
                class="text-muted-foreground hover:text-accent grid size-9 place-items-center rounded transition-colors"
                title="切换明暗主题"
                aria-label="切换明暗主题"
              >
                <IconMoon class="size-4 dark:hidden" />
                <IconSunHigh class="hidden size-4 dark:block" />
              </button>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>("#menu-btn");
  const menuItems = document.querySelector<HTMLUListElement>("#menu-items");
  const menuIcon = document.querySelector("#menu-icon");
  const closeIcon = document.querySelector("#close-icon");
  const searchLink =
    document.querySelector<HTMLAnchorElement>("#header-search");

  menuButton?.addEventListener("click", () => {
    const isOpen = menuButton.getAttribute("aria-expanded") === "true";
    menuButton.setAttribute("aria-expanded", String(!isOpen));
    menuButton.setAttribute(
      "aria-label",
      isOpen
        ? (menuButton.dataset.openLabel ?? "打开菜单")
        : (menuButton.dataset.closeLabel ?? "关闭菜单")
    );
    menuItems?.classList.toggle("hidden", isOpen);
    menuItems?.classList.toggle("flex", !isOpen);
    menuItems?.classList.toggle("max-md:flex-col", !isOpen);
    menuItems?.classList.toggle("max-md:items-stretch", !isOpen);
    menuItems?.classList.toggle("max-md:p-3", !isOpen);
    menuIcon?.classList.toggle("hidden", !isOpen);
    closeIcon?.classList.toggle("hidden", isOpen);
  });

  document.addEventListener("keydown", event => {
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
      const href = searchLink?.getAttribute("href");
      if (!href) return;
      event.preventDefault();
      window.location.assign(href);
    }
  });
</script>
