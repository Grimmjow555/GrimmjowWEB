---
type Props = {
  pageTitle: string;
  pageDesc?: string;
  eyebrow?: string;
  class?: string;
};

const {
  pageTitle,
  pageDesc,
  eyebrow = "ARCHIVE",
  class: className,
} = Astro.props;
---

<main
  id="main-content"
  class:list={["app-layout pt-12 pb-4 md:pt-16", className]}
>
  <header
    class="border-border mb-12 grid gap-5 border-b pb-8 md:grid-cols-[10rem_1fr] md:items-end"
  >
    <div class="flex items-center gap-2">
      <span
        class="bg-accent size-1.5 rounded-full shadow-[0_0_10px_var(--accent)]"
        aria-hidden="true"></span>
      <span
        class="text-muted-foreground font-mono text-[0.68rem] tracking-[0.2em]"
        >{eyebrow}</span
      >
    </div>
    <div>
      <h1
        class="font-mono text-3xl leading-tight font-semibold tracking-[-0.04em] sm:text-4xl"
      >
        {pageTitle}
      </h1>
      {
        pageDesc && (
          <p class="text-muted-foreground mt-4 max-w-2xl text-sm leading-7">
            {pageDesc}
          </p>
        )
      }
    </div>
  </header>
  <slot />
</main>
