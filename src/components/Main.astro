---
type Props = {
  pageTitle: string;
  pageDesc?: string;
  eyebrow?: string;
  class?: string;
};

const {
  pageTitle,
  pageDesc,
  eyebrow = "ARCHIVE",
  class: className,
} = Astro.props;
---

<main
  id="main-content"
  class:list={["app-layout pt-10 pb-4 md:pt-16", className]}
>
  <header
    class="border-foreground mb-10 grid gap-5 border-b-2 pb-7 md:grid-cols-[10rem_1fr] md:items-end"
  >
    <div class="flex items-center gap-3">
      <span
        class="bg-accent-bright border-foreground size-3 border-2"
        aria-hidden="true"></span>
      <span class="font-mono text-xs font-bold tracking-[0.32em]"
        >{eyebrow}</span
      >
    </div>
    <div>
      <h1
        class="font-serif text-4xl leading-none font-black tracking-tight sm:text-5xl"
      >
        {pageTitle}
      </h1>
      {
        pageDesc && (
          <p class="text-muted-foreground mt-4 max-w-2xl leading-7">
            {pageDesc}
          </p>
        )
      }
    </div>
  </header>
  <slot />
</main>
