---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Datetime from "./Datetime.astro";
import Tag from "./Tag.astro";
import { slugifyAll } from "@/utils/slugify";
import config from "@/config";

type Props = {
  note: CollectionEntry<"notes">;
  index: number;
};

const { note, index } = Astro.props;
const { id, data } = note;
const locale = Astro.currentLocale ?? config.site.lang;
const href = getRelativeLocaleUrl(locale, `notes/${id}/`);
const tags = slugifyAll(data.tags);
---

<article
  class="group border-border hover:bg-panel/35 grid border-b py-6 transition-colors md:grid-cols-[4rem_1fr_auto] md:gap-6"
>
  <span class="text-muted-foreground font-mono text-[0.68rem]">
    [{String(index + 1).padStart(2, "0")}]
  </span>
  <div>
    <a href={href} class="no-underline">
      <h3
        class="group-hover:text-accent font-mono text-lg leading-snug font-semibold tracking-tight transition-colors"
      >
        {data.title}
      </h3>
    </a>
    <p class="text-muted-foreground mt-3 max-w-2xl text-sm leading-6">
      {data.description}
    </p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {
        tags.map((tag, tagIndex) => (
          <Tag tag={tag} tagName={data.tags[tagIndex]} size="sm" />
        ))
      }
    </ul>
  </div>
  <div class="mt-4 md:mt-0 md:text-right">
    <Datetime
      pubDatetime={data.pubDatetime}
      modDatetime={data.modDatetime}
      timezone={data.timezone}
    />
    <a
      href={href}
      class="text-muted-foreground group-hover:text-accent mt-4 inline-flex font-mono text-[0.7rem] no-underline transition-colors"
    >
      cat note.md →
    </a>
  </div>
</article>
