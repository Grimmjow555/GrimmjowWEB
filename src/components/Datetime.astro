---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import config from "@/config";
import { resolveTimezone } from "@/utils/resolveTimezone";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  class?: string;
  size?: "sm" | "lg";
  pubDatetime: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
};

const {
  pubDatetime,
  modDatetime,
  size = "sm",
  class: className = "",
  timezone: contentTimezone,
} = Astro.props;

const isModified =
  modDatetime &&
  new Date(modDatetime).getTime() > new Date(pubDatetime).getTime();

const date = dayjs(isModified ? modDatetime : pubDatetime)
  .tz(resolveTimezone(contentTimezone ?? config.site.timezone))
  .format("YYYY.MM.DD");
---

<div
  class:list={[
    "text-muted-foreground flex items-center gap-2 font-mono",
    className,
  ]}
>
  <IconCalendar class:list={["size-4", { "size-5": size === "lg" }]} />
  {isModified && <span>更新于</span>}
  <time
    datetime={new Date(isModified ? modDatetime : pubDatetime).toISOString()}
  >
    {date}
  </time>
</div>
