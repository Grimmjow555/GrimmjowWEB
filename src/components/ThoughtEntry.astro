---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Datetime from "./Datetime.astro";
import Tag from "./Tag.astro";
import { slugifyAll } from "@/utils/slugify";

type Props = {
  thought: CollectionEntry<"thoughts">;
  index: number;
};

const { thought, index } = Astro.props;
const { Content } = await render(thought);
const tags = slugifyAll(thought.data.tags);
const anchor = `thought-${thought.id}`;
---

<article
  id={anchor}
  class="border-border relative grid gap-4 border-b py-7 md:grid-cols-[6rem_1fr]"
>
  <div>
    <Datetime pubDatetime={thought.data.pubDatetime} />
    <span class="text-muted-foreground mt-2 block font-mono text-[0.65rem]">
      LOG_{String(index + 1).padStart(2, "0")}
    </span>
  </div>
  <div class="border-border relative border-s pl-5">
    <span
      class="bg-accent absolute top-1.5 -left-[3.5px] size-1.5 rounded-full shadow-[0_0_9px_var(--accent)]"
      aria-hidden="true"></span>
    {
      thought.data.title && (
        <h2 class="mb-3 font-mono text-lg font-semibold tracking-tight">
          {thought.data.title}
        </h2>
      )
    }
    <div class="app-prose max-w-2xl">
      <Content />
    </div>
    <div class="mt-4 flex flex-wrap items-center gap-3">
      {
        thought.data.mood && (
          <span class="border-border bg-muted text-muted-foreground rounded border px-2 py-1 font-mono text-[0.65rem]">
            mood / {thought.data.mood}
          </span>
        )
      }
      {
        tags.length > 0 && (
          <ul class="flex flex-wrap gap-2">
            {tags.map((tag, tagIndex) => (
              <Tag tag={tag} tagName={thought.data.tags[tagIndex]} size="sm" />
            ))}
          </ul>
        )
      }
    </div>
  </div>
</article>
