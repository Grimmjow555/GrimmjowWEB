---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

type Props = {
  project: CollectionEntry<"projects">;
  featured?: boolean;
};

const { project, featured = false } = Astro.props;
const { id, data } = project;
const locale = Astro.currentLocale ?? config.site.lang;
const href = getRelativeLocaleUrl(locale, `projects/${id}/`);
const cover = getAssetPath(data.cover.replace(/^\//, ""));
const statusLabels = {
  active: "进行中",
  completed: "已完成",
  archived: "已归档",
} as const;
---

<article
  class:list={[
    "group border-border bg-panel/60 hover:border-accent/45 relative overflow-hidden rounded-md border transition-colors",
    { "md:grid md:grid-cols-[1.2fr_1fr]": featured },
  ]}
>
  <a
    href={href}
    class="border-border block overflow-hidden max-md:border-b md:border-r"
  >
    <img
      src={cover}
      alt={data.coverAlt}
      width="1200"
      height="720"
      loading="lazy"
      class="aspect-[5/3] w-full object-cover opacity-85 saturate-75 transition duration-300 motion-safe:group-hover:scale-[1.01] motion-safe:group-hover:opacity-100 motion-safe:group-hover:saturate-100"
    />
  </a>
  <div class="flex flex-col p-5 sm:p-6">
    <div class="mb-4 flex items-center justify-between gap-3">
      <span
        class="border-accent/30 bg-accent/10 text-accent rounded border px-2 py-1 font-mono text-[0.62rem]"
      >
        {statusLabels[data.status]}
      </span>
      <span class="text-muted-foreground font-mono text-xs"
        >{data.stack[0]}</span
      >
    </div>
    <a href={href} class="no-underline">
      <h3
        class="group-hover:text-accent font-mono text-xl leading-tight font-semibold tracking-tight"
      >
        {data.title}
      </h3>
    </a>
    <p class="text-muted-foreground mt-3 flex-1 text-sm leading-7">
      {data.description}
    </p>
    <div class="mt-5 flex flex-wrap gap-2 font-mono text-[0.68rem]">
      {
        data.stack.map(tech => (
          <span class="border-border text-muted-foreground rounded border px-2 py-1">
            {tech}
          </span>
        ))
      }
    </div>
    <a
      href={href}
      class="text-accent mt-6 inline-flex font-mono text-[0.7rem] no-underline hover:underline"
    >
      open project →
    </a>
  </div>
</article>
