---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    class:list={[
      "border-border bg-muted/60 text-muted-foreground hover:border-accent/50 hover:text-accent inline-flex rounded border px-2 py-1 font-mono no-underline transition-colors",
      { "text-xs": size === "sm" },
      { "text-sm": size === "lg" },
    ]}
  >
    #{tagName}
  </a>
</li>
