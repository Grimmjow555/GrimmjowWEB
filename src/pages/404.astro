---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const homeHref = getRelativeLocaleUrl(
  Astro.currentLocale ?? config.site.lang,
  ""
);
---

<Layout title={`404 | ${config.site.title}`}>
  <Header />
  <main id="main-content" class="app-layout flex flex-1 items-center py-20">
    <div class="grid w-full gap-8 md:grid-cols-[1fr_1.2fr] md:items-center">
      <p
        class="font-serif text-[clamp(8rem,24vw,18rem)] leading-[0.7] font-black tracking-[-0.09em]"
      >
        404
      </p>
      <div
        class="border-foreground bg-panel border-2 border-l-0 p-7 shadow-[7px_7px_0_var(--accent-bright)] md:border-l-2"
      >
        <span class="chapter-label">PAGE NOT FOUND</span>
        <h1 class="mt-5 font-serif text-4xl font-black">
          这一页被墨水吞掉了。
        </h1>
        <p class="text-muted-foreground mt-4 leading-7">
          链接可能已经移动，或者从未存在。回到首页，继续翻阅其他章节。
        </p>
        <a
          href={homeHref}
          class="bg-foreground text-background hover:bg-accent-bright hover:text-foreground border-foreground mt-7 inline-block border-2 px-5 py-3 font-bold no-underline transition-colors"
        >
          回到首页 →
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
