---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const homeHref = getRelativeLocaleUrl(
  Astro.currentLocale ?? config.site.lang,
  ""
);
---

<Layout title={`404 | ${config.site.title}`}>
  <Header />
  <main id="main-content" class="app-layout flex flex-1 items-center py-20">
    <div class="grid w-full gap-8 md:grid-cols-[1fr_1.2fr] md:items-center">
      <p
        class="text-accent font-mono text-[clamp(7rem,22vw,16rem)] leading-[0.75] font-semibold tracking-[-0.09em]"
      >
        404
      </p>
      <div class="border-border bg-panel/70 rounded-lg border p-7">
        <span class="chapter-label">PAGE NOT FOUND</span>
        <h1 class="mt-5 font-mono text-3xl font-semibold">这一页被删掉了。</h1>
        <p class="text-muted-foreground mt-4 leading-7">
          路由可能已经移动，或者从未存在。回到首页，继续浏览其他内容。
        </p>
        <a
          href={homeHref}
          class="bg-accent text-accent-foreground hover:bg-accent-bright mt-7 inline-block rounded px-4 py-2.5 font-mono text-sm font-semibold no-underline transition-colors"
        >
          cd ~ →
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
