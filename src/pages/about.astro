---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import config from "@/config";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error("Missing src/content/pages/about.md");
}

const { Content } = await render(about);
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
>
  <Header />
  <Breadcrumb />

  <Main
    pageTitle={about.data.title}
    pageDesc={about.data.description}
    eyebrow="PROFILE / 04"
    class="app-prose"
  >
    <div
      class="not-prose border-border bg-panel/70 mb-12 grid gap-6 rounded-lg border p-5 sm:grid-cols-[7rem_1fr] sm:items-center sm:p-7"
    >
      <div
        class="border-accent/30 bg-accent/10 text-accent grid aspect-square place-items-center rounded border font-mono text-4xl font-semibold"
      >
        &gt;_
      </div>
      <div>
        <p class="text-accent font-mono text-[0.65rem] tracking-[0.18em]">
          AUTHOR / BUILDER / READER
        </p>
        <h2 class="mt-3 font-mono text-2xl font-semibold">Grimmjow</h2>
        <p class="text-muted-foreground mt-2 max-w-xl text-sm leading-7">
          用写作整理理解，用作品验证想法，用碎碎念保留生活的毛边。
        </p>
      </div>
    </div>
    <div data-pagefind-body>
      <Content />
    </div>
  </Main>

  <Footer />
</Layout>
