---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import ThoughtEntry from "@/components/ThoughtEntry.astro";
import { getPublishedEntries } from "@/utils/content";
import config from "@/config";

const thoughts = getPublishedEntries(await getCollection("thoughts"));
---

<Layout
  title={`碎碎念 | ${config.site.title}`}
  description="没有大纲的短句、片段与瞬间。"
>
  <Header />
  <Breadcrumb />
  <Main
    pageTitle="碎碎念"
    pageDesc="没有大纲的短句、片段与瞬间。它们不被日期规训，只在想起时出现。"
    eyebrow="MOMENTS / 03"
  >
    <section class="grid gap-0 lg:grid-cols-[1fr_14rem]" data-pagefind-body>
      <div class="border-border border-t">
        {
          thoughts.map((thought, index) => (
            <ThoughtEntry thought={thought} index={index} />
          ))
        }
        {
          thoughts.length === 0 && (
            <p class="border-border text-muted-foreground rounded border border-dashed p-8 font-mono text-sm">
              // no logs yet
            </p>
          )
        }
      </div>
      <aside
        class="border-border mt-8 border-t pt-5 lg:mt-0 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-7"
      >
        <p
          class="text-muted-foreground font-mono text-[0.65rem] leading-6 tracking-[0.2em]"
        >
          FRAGMENTS<br />ARE ALSO<br />ARCHIVES.
        </p>
        <div class="bg-accent mt-7 h-1 w-16 rounded-full"></div>
      </aside>
    </section>
  </Main>
  <Footer />
</Layout>
