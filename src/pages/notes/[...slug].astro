---
import type { GetStaticPaths } from "astro";
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Datetime from "@/components/Datetime.astro";
import Tag from "@/components/Tag.astro";
import ArticleEnhancements from "@/components/ArticleEnhancements.astro";
import { getPublishedEntries } from "@/utils/content";
import { slugifyAll } from "@/utils/slugify";
import config from "@/config";

export const getStaticPaths = (async () => {
  const notes = getPublishedEntries(await getCollection("notes"));
  return notes.map((note, index) => ({
    params: { slug: note.id },
    props: {
      note,
      newer: index > 0 ? notes[index - 1] : null,
      older: index < notes.length - 1 ? notes[index + 1] : null,
    },
  }));
}) satisfies GetStaticPaths;

type Props = {
  note: CollectionEntry<"notes">;
  newer: CollectionEntry<"notes"> | null;
  older: CollectionEntry<"notes"> | null;
};

const { note, newer, older } = Astro.props;
const { Content } = await render(note);
const {
  title,
  description,
  pubDatetime,
  modDatetime,
  tags,
  timezone,
  canonicalURL,
} = note.data;
const noteTags = slugifyAll(tags);
const locale = Astro.currentLocale ?? config.site.lang;
const notesHref = getRelativeLocaleUrl(locale, "notes");
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  description={description}
  canonicalURL={canonicalURL}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
>
  <Header />
  <Breadcrumb />

  <main id="main-content" class="app-layout pt-8 pb-10" data-pagefind-body>
    <a
      href={notesHref}
      class="font-mono text-xs font-bold underline decoration-dashed underline-offset-4"
    >
      ← 返回笔记
    </a>

    <header
      class="border-foreground mt-8 grid gap-8 border-b-2 pb-9 lg:grid-cols-[1fr_14rem] lg:items-end"
    >
      <div>
        <p class="text-accent font-mono text-xs font-bold tracking-[0.3em]">
          NOTE / {note.id}
        </p>
        <h1
          class="mt-4 max-w-5xl font-serif text-4xl leading-[1.08] font-black sm:text-6xl"
        >
          {title}
        </h1>
        <p class="text-muted-foreground mt-5 max-w-3xl text-lg leading-8">
          {description}
        </p>
      </div>
      <div
        class="border-foreground bg-panel border-2 p-4 shadow-[4px_4px_0_var(--accent-bright)]"
      >
        <Datetime
          pubDatetime={pubDatetime}
          modDatetime={modDatetime}
          timezone={timezone}
          size="lg"
        />
        <p class="text-muted-foreground mt-3 font-mono text-xs">READING LOG</p>
      </div>
    </header>

    <div class="mx-auto mt-12 grid max-w-5xl gap-10 lg:grid-cols-[1fr_10rem]">
      <article id="article" class="app-prose max-w-3xl">
        <Content />
      </article>
      <aside class="hidden lg:block">
        <div class="border-foreground sticky top-6 border-t-2 pt-4">
          <p class="font-mono text-[0.65rem] tracking-[0.25em]">TAGS</p>
          <ul class="mt-3 flex flex-col items-start gap-2">
            {
              noteTags.map((tag, index) => (
                <Tag tag={tag} tagName={tags[index]} size="sm" />
              ))
            }
          </ul>
        </div>
      </aside>
    </div>

    <ul class="mt-10 flex flex-wrap gap-2 lg:hidden">
      {
        noteTags.map((tag, index) => (
          <Tag tag={tag} tagName={tags[index]} size="sm" />
        ))
      }
    </ul>
    <ArticleEnhancements />

    <nav
      class="border-foreground mt-14 grid gap-0 border-y-2 sm:grid-cols-2"
      aria-label="相邻笔记"
    >
      {
        older ? (
          <a
            href={getRelativeLocaleUrl(locale, `notes/${older.id}/`)}
            class="hover:bg-foreground hover:text-background border-foreground p-5 no-underline transition-colors sm:border-r"
          >
            <span class="font-mono text-xs opacity-65">← 更早</span>
            <strong class="mt-2 block font-serif text-lg">
              {older.data.title}
            </strong>
          </a>
        ) : (
          <span />
        )
      }
      {
        newer ? (
          <a
            href={getRelativeLocaleUrl(locale, `notes/${newer.id}/`)}
            class="hover:bg-foreground hover:text-background border-foreground p-5 text-right no-underline transition-colors max-sm:border-t-2"
          >
            <span class="font-mono text-xs opacity-65">更新 →</span>
            <strong class="mt-2 block font-serif text-lg">
              {newer.data.title}
            </strong>
          </a>
        ) : (
          <span />
        )
      }
    </nav>

    <div class="mt-8 text-right">
      <a
        href="#top"
        class="font-mono text-xs font-bold underline decoration-dashed underline-offset-4"
      >
        返回顶部 ↑
      </a>
    </div>
  </main>

  <Footer />
</PostLayout>
