---
import "@pagefind/default-ui/css/ui.css";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

const pagefindBundlePath = getAssetPath("pagefind/");
---

<Layout
  title={`搜索 | ${config.site.title}`}
  description="搜索全部公开笔记、作品与碎碎念。"
>
  <Header />
  <Breadcrumb />
  <Main
    pageTitle="搜索"
    pageDesc="输入关键词，搜索笔记、作品与碎碎念。索引在构建时生成，不会把访客信息发往第三方。"
    eyebrow="FIND / SIGNAL"
  >
    <div
      id="pagefind-search"
      class="mx-auto max-w-3xl"
      data-bundle-path={pagefindBundlePath}
    >
    </div>
  </Main>
  <Footer />
</Layout>

<script>
  async function initSearch() {
    const host = document.querySelector<HTMLElement>("#pagefind-search");
    const bundlePath = host?.dataset.bundlePath;
    if (!host || !bundlePath) return;

    if (host.querySelector("form")) return;

    // @ts-expect-error Pagefind default UI does not ship TypeScript declarations.
    const { PagefindUI } = await import("@pagefind/default-ui");
    const params = new URLSearchParams(window.location.search);

    const search = new PagefindUI({
      element: "#pagefind-search",
      bundlePath,
      showImages: false,
      showSubResults: true,
      translations: {
        placeholder: "搜索笔记、作品或碎碎念…",
        zero_results: "没有找到与 [SEARCH_TERM] 相关的内容",
        many_results: "找到 [COUNT] 条与 [SEARCH_TERM] 相关的内容",
        one_result: "找到 1 条与 [SEARCH_TERM] 相关的内容",
        alt_search: "没有找到 [SEARCH_TERM]，改为显示 [DIFFERENT_TERM] 的结果",
        search_suggestion: "可以试试其他关键词",
        searching: "正在搜索 [SEARCH_TERM]…",
      },
      processTerm(term: string) {
        if (term) params.set("q", term);
        else params.delete("q");
        const query = params.toString();
        history.replaceState(
          history.state,
          "",
          query ? `?${query}` : location.pathname
        );
        return term;
      },
    });

    const initialQuery = params.get("q");
    if (initialQuery) search.triggerSearch(initialQuery);
  }

  initSearch();
</script>

<style is:global>
  #pagefind-search {
    --pagefind-ui-font: var(--font-app);
    --pagefind-ui-text: var(--foreground);
    --pagefind-ui-background: var(--background);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-tag: var(--muted);
    --pagefind-ui-border-radius: 0;
    --pagefind-ui-border-width: 2px;
    --pagefind-ui-image-border-radius: 0;
    --pagefind-ui-image-box-ratio: 5 / 3;
  }

  #pagefind-search form::before {
    background-color: var(--foreground);
  }

  #pagefind-search input {
    border: 2px solid var(--border);
    font-size: 1.1rem;
  }

  #pagefind-search input:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
  }

  #pagefind-search .pagefind-ui__result {
    border-bottom: 1px dashed var(--border);
    padding-block: 1rem;
  }

  #pagefind-search .pagefind-ui__result-title a {
    color: var(--foreground);
    font-family: var(--font-serif);
    font-size: 1.35rem;
    text-decoration: underline dashed var(--accent);
    text-underline-offset: 4px;
  }
</style>
