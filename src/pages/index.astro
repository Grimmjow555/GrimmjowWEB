---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import NoteCard from "@/components/NoteCard.astro";
import ThoughtEntry from "@/components/ThoughtEntry.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { getPublishedEntries } from "@/utils/content";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

const [allNotes, allProjects, allThoughts] = await Promise.all([
  getCollection("notes"),
  getCollection("projects"),
  getCollection("thoughts"),
]);

const notes = getPublishedEntries(allNotes);
const projects = getPublishedEntries(allProjects);
const thoughts = getPublishedEntries(allThoughts);
const visibleProjects = [
  ...projects.filter(project => project.data.featured),
  ...projects.filter(project => !project.data.featured),
].slice(0, config.content.homeProjects);
const latestNotes = notes.slice(0, config.content.homeNotes);
const latestThoughts = thoughts.slice(0, config.content.homeThoughts);

const locale = Astro.currentLocale ?? config.site.lang;
const notesHref = getRelativeLocaleUrl(locale, "notes");
const projectsHref = getRelativeLocaleUrl(locale, "projects");
const thoughtsHref = getRelativeLocaleUrl(locale, "thoughts");
const aboutHref = getRelativeLocaleUrl(locale, "about");
const heroImage = getAssetPath("ink/hero-brush.svg");
---

<Layout>
  <Header />

  <main id="main-content">
    <section
      class="app-layout grid min-h-[calc(100svh-4.5rem)] items-center gap-8 overflow-x-clip py-10 md:grid-cols-12 md:py-16"
    >
      <div class="relative z-10 md:col-span-7 lg:col-span-6">
        <div class="mb-7 flex flex-wrap items-center gap-3">
          <span class="chapter-label">CHAPTER 01</span>
          <span
            class="text-muted-foreground font-mono text-[0.68rem] tracking-[0.22em]"
          >
            NOTES / WORKS / MOMENTS
          </span>
        </div>

        <h1 class="font-serif leading-[0.84] font-black tracking-[-0.055em]">
          <span
            class="block max-w-full text-[clamp(3.25rem,8.7vw,7.6rem)] uppercase"
            >Grimmjow</span
          >
          <span
            class="mt-3 block text-[clamp(1.8rem,4vw,3.4rem)] tracking-[-0.03em]"
          >
            在墨迹与代码之间
          </span>
        </h1>

        <p class="mt-7 max-w-xl text-base leading-8 sm:text-lg">
          这里记录正在理解的知识、已经落笔的作品，以及那些没有大纲、却值得留下的瞬间。
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={notesHref}
            class="bg-foreground text-background hover:bg-accent-bright hover:text-foreground border-foreground border-2 px-5 py-3 font-bold no-underline shadow-[5px_5px_0_var(--accent-bright)] transition-all hover:translate-x-1 hover:translate-y-1 hover:shadow-none"
          >
            翻阅笔记
          </a>
          <a
            href={projectsHref}
            class="bg-background hover:bg-foreground hover:text-background border-foreground border-2 px-5 py-3 font-bold no-underline transition-colors"
          >
            查看作品
          </a>
        </div>

        <dl
          class="border-foreground mt-10 grid max-w-lg grid-cols-3 border-y-2 py-4"
        >
          <div class="border-foreground border-r px-3 first:pl-0">
            <dt
              class="text-muted-foreground font-mono text-[0.65rem] tracking-wider"
            >
              NOTE
            </dt>
            <dd class="mt-1 font-serif text-2xl font-black">
              {String(notes.length).padStart(2, "0")}
            </dd>
          </div>
          <div class="border-foreground border-r px-3">
            <dt
              class="text-muted-foreground font-mono text-[0.65rem] tracking-wider"
            >
              WORK
            </dt>
            <dd class="mt-1 font-serif text-2xl font-black">
              {String(projects.length).padStart(2, "0")}
            </dd>
          </div>
          <div class="px-3">
            <dt
              class="text-muted-foreground font-mono text-[0.65rem] tracking-wider"
            >
              MOMENT
            </dt>
            <dd class="mt-1 font-serif text-2xl font-black">
              {String(thoughts.length).padStart(2, "0")}
            </dd>
          </div>
        </dl>
      </div>

      <figure class="relative md:col-span-5 lg:col-span-6">
        <div
          class="border-foreground bg-panel absolute -inset-3 rotate-2 border-2"
          aria-hidden="true"
        >
        </div>
        <img
          src={heroImage}
          alt="原创黑白水墨抽象图形，留白中划过一道电光青"
          width="1200"
          height="900"
          class="border-foreground relative z-10 w-full border-2 object-cover"
        />
        <figcaption
          class="bg-foreground text-background absolute right-4 bottom-4 z-20 max-w-[12rem] px-3 py-2 font-mono text-[0.65rem] leading-5 tracking-wider"
        >
          INK STUDY / 001<br />留白不是空缺，是呼吸。
        </figcaption>
      </figure>
    </section>

    <div class="app-layout pb-16">
      <section aria-labelledby="projects-title" class="pt-8">
        <div id="projects-title">
          <SectionHeading
            index="章二 / 02"
            title="精选作品"
            href={projectsHref}
          />
        </div>
        {
          visibleProjects.length > 0 ? (
            <div class="grid gap-7 md:grid-cols-2">
              {visibleProjects.map((project, index) => (
                <div
                  class:list={[
                    {
                      "md:col-span-2":
                        index === 0 && visibleProjects.length > 1,
                    },
                  ]}
                >
                  <ProjectCard project={project} featured={index === 0} />
                </div>
              ))}
            </div>
          ) : (
            <p class="border-foreground text-muted-foreground border border-dashed p-6">
              作品正在绘制中。
            </p>
          )
        }
      </section>

      <div class="mt-20 grid gap-14 lg:grid-cols-[1.45fr_0.75fr]">
        <section aria-labelledby="notes-title">
          <div id="notes-title">
            <SectionHeading
              index="章三 / 03"
              title="最近笔记"
              href={notesHref}
            />
          </div>
          <div>
            {
              latestNotes.map((note, index) => (
                <NoteCard note={note} index={index} />
              ))
            }
          </div>
        </section>

        <section
          aria-labelledby="thoughts-title"
          class="lg:border-foreground lg:border-l-2 lg:pl-8"
        >
          <div id="thoughts-title">
            <SectionHeading
              index="章四 / 04"
              title="最近碎念"
              href={thoughtsHref}
            />
          </div>
          <div>
            {
              latestThoughts.map((thought, index) => (
                <ThoughtEntry thought={thought} index={index} />
              ))
            }
          </div>
        </section>
      </div>

      <section
        class="border-foreground bg-foreground text-background mt-16 grid gap-6 border-2 p-6 sm:grid-cols-[1fr_auto] sm:items-center sm:p-8"
      >
        <div>
          <p class="text-accent-bright font-mono text-xs tracking-[0.3em]">
            NEXT CHAPTER
          </p>
          <h2 class="mt-2 font-serif text-3xl font-black">
            故事还缺一段自我介绍。
          </h2>
        </div>
        <a
          href={aboutHref}
          class="bg-accent-bright text-foreground border-background border-2 px-5 py-3 text-center font-bold no-underline transition-transform hover:-translate-y-1"
        >
          关于我 →
        </a>
      </section>
    </div>
  </main>

  <Footer noMarginTop />
</Layout>
