---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import NoteCard from "@/components/NoteCard.astro";
import ThoughtEntry from "@/components/ThoughtEntry.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { getPublishedEntries } from "@/utils/content";
import config from "@/config";

const [allNotes, allProjects, allThoughts] = await Promise.all([
  getCollection("notes"),
  getCollection("projects"),
  getCollection("thoughts"),
]);

const notes = getPublishedEntries(allNotes);
const projects = getPublishedEntries(allProjects);
const thoughts = getPublishedEntries(allThoughts);
const visibleProjects = [
  ...projects.filter(project => project.data.featured),
  ...projects.filter(project => !project.data.featured),
].slice(0, config.content.homeProjects);
const latestNotes = notes.slice(0, config.content.homeNotes);
const latestThoughts = thoughts.slice(0, config.content.homeThoughts);

const locale = Astro.currentLocale ?? config.site.lang;
const notesHref = getRelativeLocaleUrl(locale, "notes");
const projectsHref = getRelativeLocaleUrl(locale, "projects");
const thoughtsHref = getRelativeLocaleUrl(locale, "thoughts");
const aboutHref = getRelativeLocaleUrl(locale, "about");
---

<Layout>
  <Header />

  <main id="main-content">
    <section
      class="app-layout grid min-h-[calc(100svh-4rem)] items-center gap-12 py-16 lg:grid-cols-[1.15fr_0.85fr] lg:py-24"
    >
      <div>
        <div class="mb-8 flex flex-wrap items-center gap-3 font-mono text-xs">
          <span class="inline-flex items-center gap-2">
            <span
              class="bg-accent size-1.5 rounded-full shadow-[0_0_10px_var(--accent)]"
              aria-hidden="true"></span>
            <span class="text-accent">SYSTEM ONLINE</span>
          </span>
          <span class="text-border" aria-hidden="true">/</span>
          <span class="text-muted-foreground">~/grimmjow</span>
        </div>

        <p class="chapter-label mb-4">HELLO, WORLD</p>
        <h1
          class="font-mono text-[clamp(3.25rem,9vw,7.5rem)] leading-[0.9] font-semibold tracking-[-0.075em]"
        >
          Grimmjow<span class="terminal-cursor" aria-hidden="true"></span>
        </h1>
        <h2
          class="text-muted-foreground mt-5 font-mono text-base font-medium tracking-tight sm:text-xl"
        >
          build · learn · iterate
        </h2>

        <p class="mt-7 max-w-xl leading-8">
          在代码、知识与创作之间持续构建。这里记录学习过程、个人作品，以及那些零散但真实的念头。
        </p>

        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href={notesHref}
            class="bg-accent text-accent-foreground hover:bg-accent-bright inline-flex rounded border border-transparent px-4 py-2.5 font-mono text-sm font-semibold no-underline transition-colors"
          >
            读取笔记 <span aria-hidden="true">→</span>
          </a>
          <a
            href={projectsHref}
            class="border-border text-foreground hover:border-accent/50 hover:text-accent inline-flex rounded border bg-transparent px-4 py-2.5 font-mono text-sm font-semibold no-underline transition-colors"
          >
            浏览作品 <span aria-hidden="true">↗</span>
          </a>
        </div>

        <dl
          class="border-border mt-12 flex max-w-lg flex-wrap gap-x-10 gap-y-3 border-t pt-5 font-mono"
        >
          <div class="flex items-baseline gap-2">
            <dt class="text-muted-foreground text-[0.65rem]">NOTES</dt>
            <dd class="text-accent text-lg">
              {String(notes.length).padStart(2, "0")}
            </dd>
          </div>
          <div class="flex items-baseline gap-2">
            <dt class="text-muted-foreground text-[0.65rem]">WORKS</dt>
            <dd class="text-accent text-lg">
              {String(projects.length).padStart(2, "0")}
            </dd>
          </div>
          <div class="flex items-baseline gap-2">
            <dt class="text-muted-foreground text-[0.65rem]">THOUGHTS</dt>
            <dd class="text-accent text-lg">
              {String(thoughts.length).padStart(2, "0")}
            </dd>
          </div>
        </dl>
      </div>

      <div class="terminal-panel overflow-hidden font-mono text-sm">
        <div class="terminal-bar">
          <span class="terminal-dot terminal-dot-accent" aria-hidden="true"
          ></span>
          <span class="terminal-dot" aria-hidden="true"></span>
          <span class="terminal-dot" aria-hidden="true"></span>
          <span class="ms-2">~/profile.sh</span>
          <span class="ms-auto">zsh</span>
        </div>
        <div class="space-y-5 p-5 sm:p-7">
          <div>
            <p><span class="text-accent">$</span> whoami</p>
            <p class="text-muted-foreground mt-1 pl-4">Grimmjow</p>
          </div>
          <div>
            <p><span class="text-accent">$</span> cat focus.txt</p>
            <p class="text-muted-foreground mt-1 pl-4 leading-7">
              learning in public<br />
              shipping small ideas<br />
              writing down the process
            </p>
          </div>
          <div>
            <p><span class="text-accent">$</span> ls ./content</p>
            <div class="text-muted-foreground mt-1 grid grid-cols-2 gap-2 pl-4">
              <span>notes/</span>
              <span>projects/</span>
              <span>thoughts/</span>
              <span class="text-accent">about.md</span>
            </div>
          </div>
          <div
            class="border-border flex items-center gap-2 border-t pt-5 text-xs"
          >
            <span class="bg-accent size-1.5 rounded-full" aria-hidden="true"
            ></span>
            <span class="text-muted-foreground">status:</span>
            <span class="text-foreground">building in public</span>
          </div>
        </div>
      </div>
    </section>

    <div class="app-layout pb-16">
      <section aria-labelledby="projects-title" class="pt-10">
        <div id="projects-title">
          <SectionHeading
            index="01 / WORK"
            title="Selected projects"
            href={projectsHref}
          />
        </div>
        {
          visibleProjects.length > 0 ? (
            <div class="grid gap-6 md:grid-cols-2">
              {visibleProjects.map((project, index) => (
                <div
                  class:list={[
                    {
                      "md:col-span-2":
                        index === 0 && visibleProjects.length > 1,
                    },
                  ]}
                >
                  <ProjectCard project={project} featured={index === 0} />
                </div>
              ))}
            </div>
          ) : (
            <p class="border-border text-muted-foreground rounded border border-dashed p-6 font-mono text-sm">
              // no public projects yet
            </p>
          )
        }
      </section>

      <div class="mt-24 grid gap-16 lg:grid-cols-[1.35fr_0.65fr]">
        <section aria-labelledby="notes-title">
          <div id="notes-title">
            <SectionHeading
              index="02 / NOTES"
              title="Latest notes"
              href={notesHref}
            />
          </div>
          <div>
            {
              latestNotes.map((note, index) => (
                <NoteCard note={note} index={index} />
              ))
            }
          </div>
        </section>

        <section
          aria-labelledby="thoughts-title"
          class="lg:border-border lg:border-l lg:pl-8"
        >
          <div id="thoughts-title">
            <SectionHeading
              index="03 / LOGS"
              title="Recent thoughts"
              href={thoughtsHref}
            />
          </div>
          <div>
            {
              latestThoughts.map((thought, index) => (
                <ThoughtEntry thought={thought} index={index} />
              ))
            }
          </div>
        </section>
      </div>

      <section
        class="border-border bg-panel/70 mt-20 flex flex-col gap-6 rounded-lg border p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8"
      >
        <div>
          <p class="text-accent font-mono text-[0.68rem] tracking-[0.16em]">
            NEXT / ABOUT
          </p>
          <h2 class="mt-2 font-mono text-2xl font-semibold">
            维护一个持续运行的个人系统。
          </h2>
        </div>
        <a
          href={aboutHref}
          class="border-accent/30 text-accent hover:bg-accent hover:text-accent-foreground shrink-0 rounded border px-4 py-2.5 text-center font-mono text-sm font-semibold no-underline transition-colors"
        >
          关于我 →
        </a>
      </section>
    </div>
  </main>

  <Footer noMarginTop />
</Layout>
