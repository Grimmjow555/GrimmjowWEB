---
import Layout from "@/layouts/Layout.astro";
import config from "@/config";

const cmsUrl = config.site.adminUrl;

if (!cmsUrl) {
  throw new Error("Missing site.adminUrl configuration");
}
---

<Layout title={`内容管理 | ${config.site.title}`}>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`2;url=${cmsUrl}`} />
  </Fragment>

  <main
    id="main-content"
    class="app-layout flex flex-1 items-center justify-center py-16"
  >
    <section
      class="border-foreground bg-panel w-full max-w-2xl border-2 p-7 shadow-[8px_8px_0_var(--accent-bright)] sm:p-10"
    >
      <span class="chapter-label">PRIVATE DESK</span>
      <h1 class="mt-5 font-serif text-4xl font-black">内容管理</h1>
      <p class="text-muted-foreground mt-4 leading-7">
        正在前往 Pages CMS。编辑权限由 GitHub 仓库写权限决定，网站不会保存你的
        Token 或密码。
      </p>
      <a
        href={cmsUrl}
        rel="noreferrer"
        class="bg-foreground text-background hover:bg-accent-bright hover:text-foreground border-foreground mt-7 inline-block border-2 px-5 py-3 font-bold no-underline transition-colors"
      >
        进入内容管理 →
      </a>
      <p class="text-muted-foreground mt-5 font-mono text-xs">
        若没有自动跳转，请点击上方按钮。
      </p>
    </section>
  </main>
</Layout>

<script is:inline define:vars={{ cmsUrl }}>
  window.setTimeout(() => window.location.replace(cmsUrl), 800);
</script>
